#!/usr/bin/env python3
"""pier — run named Pi subagents from agent Markdown files."""
import sys
from pathlib import Path

# Import the modules beside this entrypoint, following a symlinked install.
sys.path.insert(0, str(Path(__file__).resolve().parent))

import argparse
import shlex
import signal
import subprocess
import tempfile
import time
import uuid
from typing import Any, Dict, List, Optional, Sequence

from pier_agents import (collect_agents, load_agent_file,
                         resolve_agent, validate_agent_text)
from pi_runtime import (RunSpec, _on_signal, build_flags, max_chars, pi_argv,
                        prompt_args, report, resolve_pi_binary, resolve_spec,
                        run_turn, summary_line)
from pi_state import (FAILED_STOPS, PierError, cleanup_worktree,
                      ensure_not_running, find_session_file, fmt_age,
                      fmt_tokens, iter_sidecars, last_turn, load_sidecar,
                      make_worktree, pier_home, resolve_ref, restore_project_cwd,
                      running_pid,
                      session_lock, sessions_dir, sidecar_path, sid_to_ref,
                      start_session)
from toon import encode_toon

VERSION = "0.1.0"
DRY_RUN_ARG_CHARS = 400
PS_LIMIT = 10
PS_REPLY_CHARS = 60


def _read_text(path: Path, what: str) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise PierError(f"cannot read {what} {str(path)!r}: {exc}") from None


def emit(obj: Any) -> None:
    # Document itself has no trailing newline (TOON 4.4); print adds the line terminator.
    print(encode_toon(obj))


def _clean_task(task: str) -> str:
    task = task.strip()
    if not task:
        raise PierError("empty task (give task words, or pipe/heredoc stdin)")
    return task


def read_task(words: List[str]) -> str:
    """Task text: the words, or stdin when no words are given (heredoc/pipe)."""
    if words:
        return _clean_task(" ".join(words))
    if sys.stdin.isatty():
        raise PierError("no task given (pass task words, or pipe/heredoc stdin)")
    return _clean_task(sys.stdin.read())


def spec_from_args(args: argparse.Namespace) -> RunSpec:
    cwd = Path.cwd()
    words = list(args.words)
    if args.agent_file:
        path = Path(args.agent_file).expanduser()
        if not path.is_file():
            raise PierError(f"agent file not found: {path}")
        agent = load_agent_file(path)
    elif words:
        agent = resolve_agent(words.pop(0), collect_agents(cwd))
    else:
        raise PierError("missing AGENT (or --agent-file)")
    return RunSpec(cwd=cwd, agent=agent, task=read_task(words), model=args.model)


def cmd_run(args: argparse.Namespace) -> int:
    home = pier_home()
    spec = resolve_spec(spec_from_args(args))
    flags = build_flags(spec)
    if args.dry_run:
        cwd = spec.cwd
        notes = list(spec.notes)
        if args.worktree:
            cwd = home / "worktrees" / "<ref>"
            notes.append(f"--worktree: Pi runs in {cwd}, a detached worktree of {spec.cwd} HEAD")
        print_dry_run(cwd, notes, home, flags, ["--session-id", "<new-session-id>"], spec.task)
        return 0
    budget = max_chars()
    binary = resolve_pi_binary()
    sid = str(uuid.uuid4())
    ref = sid_to_ref(sid)
    wt = None
    try:
        if args.worktree:
            wt = make_worktree(home, ref, spec.cwd)
            spec.cwd = Path(wt["worktree"])
        start_session(home, sid, spec.cwd, flags, spec.agent.name, wt)
        print(f"pier: {ref} started ({spec.agent.name})", file=sys.stderr, flush=True)
        out, _ = run_turn(home, binary, sid, spec.cwd, flags, ["--session-id", sid], spec.task)
    finally:
        # Before the summary: cleanup can print, and the last stderr line stays
        # the summary.
        if wt:
            cleanup_worktree(home, sid, ref, wt)
    print(summary_line(ref, out, spec.agent.name), file=sys.stderr)
    return report(out, home, sid, budget)


def print_dry_run(cwd: Path, notes: List[str], home: Path, flags: List[str],
                  session_args: List[str], prompt: str) -> None:
    for n in notes:
        print(f"pier: note: {n}", file=sys.stderr)
    binary = resolve_pi_binary(required=False)
    placeholder = Path(tempfile.gettempdir()) / "pier-XXXX" / "prompt.md"
    argv = pi_argv(binary, home, flags, session_args, prompt_args(prompt, placeholder, write=False))
    shown = " ".join(shlex.quote(_clip_for_dry_run(a)) for a in argv)
    print(f"cd {shlex.quote(str(cwd))} && {shown}")


def _clip_for_dry_run(arg: str) -> str:
    if len(arg) <= DRY_RUN_ARG_CHARS:
        return arg
    return f"{arg[:DRY_RUN_ARG_CHARS]}…<{len(arg)} chars>"


def cmd_send(args: argparse.Namespace) -> int:
    home = pier_home()
    sid = resolve_ref(home, args.session)
    side = load_sidecar(home, sid)
    ref = sid_to_ref(sid)
    task = read_task(list(args.words))
    sfile = find_session_file(home, sid)
    if not sfile:
        raise PierError(f"session {ref} has no Pi session file under {sessions_dir(home)}")
    cwd = Path(side["cwd"])
    if not cwd.is_dir() and side.get("worktree") == side["cwd"]:
        # The kept worktree was removed by hand: continue in the project.
        cwd = Path(side["origin_cwd"])
        restore_project_cwd(home, sid, side)
    if not cwd.is_dir():
        raise PierError(f"session {ref} cwd is gone: {cwd}")
    budget = max_chars()
    ensure_not_running(ref, side)
    binary = resolve_pi_binary()
    with session_lock(home, sid):
        ensure_not_running(ref, load_sidecar(home, sid))  # a run may have started since
        out, _ = run_turn(home, binary, sid, cwd, side["flags"], ["--session", str(sfile)], task)
    print(summary_line(ref, out, side.get("agent")), file=sys.stderr)
    return report(out, home, sid, budget)


def session_row(home: Path, sid: str, data: Dict[str, Any], mtime: float) -> Dict[str, Any]:
    """One `ps` row: state from the sidecar pid + the session file's last turn."""
    sfile = find_session_file(home, sid)
    turn = last_turn(sfile) if sfile else None
    if running_pid(data) is not None:
        state = "running"
    elif isinstance(data.get("pid"), int):
        state = "failed"  # pid recorded but no longer alive: a killed run
    elif turn and turn.reply and turn.stop not in FAILED_STOPS + ("length",):
        state = "ok"
    else:
        state = "failed"  # includes a Pi that exited before writing the session
    tok = ""
    if turn and turn.usage:
        total = turn.usage.get("totalTokens")
        if isinstance(total, (int, float)):
            tok = fmt_tokens(int(total))
    # The report contract puts the result first, so the first line is the gist.
    reply = (turn.reply.splitlines()[0] if turn and turn.reply else "")[:PS_REPLY_CHARS]
    return {"ref": sid_to_ref(sid), "agent": data.get("agent") or "?", "state": state,
            "age": fmt_age(int(time.time() - mtime)), "tok": tok, "reply": reply}


def cmd_ps(args: argparse.Namespace) -> int:
    home = pier_home()
    if args.session:
        sid = resolve_ref(home, args.session)
        rows = [session_row(home, sid, load_sidecar(home, sid),
                            sidecar_path(home, sid).stat().st_mtime)]
    else:
        cwd = str(Path.cwd().resolve())
        rows = []
        total = 0
        for sid, data, mtime in iter_sidecars(home):
            # A --worktree session runs in its own checkout but belongs here.
            if cwd not in (data.get("cwd"), data.get("origin_cwd")):
                continue
            total += 1
            if len(rows) < PS_LIMIT:
                rows.append(session_row(home, sid, data, mtime))
        if total > PS_LIMIT:
            print(f"pier: note: showing {PS_LIMIT} of {total} sessions (newest first)",
                  file=sys.stderr)
    if not rows:
        print("pier: no sessions (run one first)", file=sys.stderr)
        return 0
    emit({"sessions": rows})
    return 0


def cmd_agents(args: argparse.Namespace) -> int:
    if args.agents_cmd == "validate":
        if args.file == "-":
            text, fallback = sys.stdin.read(), None
        else:
            path = Path(args.file).expanduser()
            text, fallback = _read_text(path, "agent file"), path.stem
        rep = validate_agent_text(text, fallback)
        emit(rep)
        return 0 if rep["ok"] else 1
    agents = collect_agents(Path.cwd())
    if args.agents_cmd == "list":
        emit([{"name": a.name, "model": a.model or "", "description": a.description}
              for a in sorted(agents.values(), key=lambda x: x.name)])
        return 0
    a = resolve_agent(args.name, agents)
    print(a.path)
    print()
    print(_read_text(a.path, "agent file").rstrip())
    return 0


class _Parser(argparse.ArgumentParser):
    """No long-option abbreviations: `--hel` must not silently turn into help."""

    def __init__(self, *args, **kwargs):
        kwargs.setdefault("allow_abbrev", False)
        super().__init__(*args, **kwargs)


def build_parser() -> argparse.ArgumentParser:
    p = _Parser(prog="pier", description="Run named Pi subagents from agent Markdown files. "
                "Every run is synchronous and prints only the reply on stdout. "
                "Env: PI_BIN, PIER_HOME, PIER_MAX_CHARS.")
    p.add_argument("--version", action="version", version=f"pier {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    sp = sub.add_parser("run", help="start a new Pi session and print its reply",
                        description="Start a new Pi session in the current directory, wait for "
                        "it, print the reply. stderr: 'pier: <ref> started (<agent>)' first, "
                        "'pier: <ref> ok (<agent>)' last.")
    sp.add_argument("words", nargs="*", metavar="AGENT TASK",
                    help="agent name, then the task as words (none = stdin); "
                         "with --agent-file every word is task")
    sp.add_argument("--agent-file", metavar="PATH", help="use this agent .md instead of AGENT "
                    "(frontmatter optional: a plain text file is just a role)")
    sp.add_argument("--model", metavar="PROVIDER/ID[:LEVEL]",
                    help="Pi --model; overrides frontmatter; ':LEVEL' sets thinking")
    sp.add_argument("--worktree", action="store_true",
                    help="run Pi in a git worktree of HEAD (snapshot, no uncommitted changes); "
                         "clean at exit -> auto-removed, dirty -> kept and its path printed")
    sp.add_argument("--dry-run", action="store_true",
                    help="print the exact Pi command; runs nothing, writes nothing")

    sp = sub.add_parser("send", help="send a follow-up to an existing session",
                        description="Continue a session with the same agent setup (system prompt, "
                        "tools, skills, extensions) as its first run, and print the reply.")
    sp.add_argument("session", metavar="REF", help="8-char ref from run (or the full uuid)")
    sp.add_argument("words", nargs="*", metavar="TASK",
                    help="follow-up message as words; with no words, read stdin (heredoc/pipe)")

    sp = sub.add_parser("ps", help="list recent sessions (TOON)",
                        description="Sessions of the current directory (10 most recent, TOON): "
                                    "{ref, agent, state, age, tok, reply}. With REF, that one.")
    sp.add_argument("session", nargs="?", metavar="REF",
                    help="8-char ref; omit for this directory's sessions")

    ap = sub.add_parser("agents", help="list, inspect or validate agent files")
    asub = ap.add_subparsers(dest="agents_cmd", required=True, metavar="ACTION")
    asub.add_parser("list", help="name, model, description of every agent (TOON)")
    asub.add_parser("show", help="print an agent's path and file").add_argument(
        "name", metavar="NAME", help="agent name")
    asub.add_parser("validate", help="check an agent .md; exit 1 on errors").add_argument(
        "file", metavar="PATH", help="agent .md ('-' = stdin)")
    return p


def main(argv: Optional[Sequence[str]] = None) -> int:
    args_list = list(sys.argv[1:] if argv is None else argv)
    # argparse reads a single-dash token longer than 2 chars as a cluster of
    # short flags, so `-hello` becomes `-h` + `-e ...` and prints help, exit 0.
    # pier has no short flags other than -h, so such a token is a task that
    # starts with '-': it belongs after `--`.
    for tok in args_list:
        if tok == "--":
            break
        if len(tok) > 2 and tok.startswith("-") and not tok.startswith("--"):
            print(f"pier: error: unrecognized option {tok!r} "
                  "(a task that starts with '-' goes after '--')",
                  file=sys.stderr)
            return 2
    try:
        args = build_parser().parse_args(args_list)
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            signal.signal(sig, _on_signal)
        return {"run": cmd_run, "send": cmd_send,
                "ps": cmd_ps, "agents": cmd_agents}[args.cmd](args)
    except PierError as exc:
        print(f"pier: error: {exc}", file=sys.stderr)
        return 2
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"pier: error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
