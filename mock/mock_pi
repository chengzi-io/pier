#!/usr/bin/env python3
"""Deterministic Pi CLI mock for pier tests. Never calls a model.

Shaped after real Pi 1.5.0 behaviour that pier depends on:
- unknown options -> "Error: Unknown option: X", exit 1
- `--mode json` session event: {"type":"session","version":3,"id","timestamp","cwd"} (no file path)
- session file <session-dir>/<ts>_<id>.jsonl (Pi 1.4.0 with --session-dir) holding a session header
  and {"type":"message","message":{"role":"user"|"assistant",...}} entries; the user
  message is written before the model "thinks", the assistant reply after
- `--session REF` that matches nothing -> "No session found matching", exit 1
- piped stdin is prepended to the prompt (pier must pass /dev/null)
- `@path` positional includes the file text in the prompt
- assistant entries carry a `usage` block {input, output, cacheRead, cacheWrite,
  totalTokens, cost:{input,output,total}} like real Pi 1.4.0; MOCK_PI_USAGE=<in>,<out>
  overrides the default

Env: MOCK_PI_RECORD (file, last argv), MOCK_PI_RECORD_DIR (one file per call),
MOCK_PI_RECORD_CWD (file, the cwd each call runs in),
MOCK_PI_FAIL=1, MOCK_PI_FAIL_ON=<substring of prompt>, MOCK_PI_SLEEP=<s>,
MOCK_PI_SLEEP_ON=<substring>, MOCK_PI_REPLY=<text>,
MOCK_PI_STOP=error|aborted|length (final assistant stopReason; error/aborted first write
an intermediate "let me look" text + tool call, as a real failing turn can; print mode
then exits 1, JSON mode exits 0 like real Pi).
"""
from __future__ import annotations

import json
import os
import sys
import time
import uuid
from pathlib import Path

VALUE_FLAGS = {"--provider", "--model", "--thinking", "--tools", "-t", "--exclude-tools", "-xt",
               "--name", "-n", "--session", "--session-id", "--session-dir", "--mode",
               "--system-prompt", "--append-system-prompt", "--api-key", "-e", "--extension",
               "--skill", "--models", "--export", "--fork"}
# Flags that may appear more than once; stored as lists in opts.
MULTI_VALUE_FLAGS = {"--skill", "--extension", "-e", "--append-system-prompt"}
BOOL_FLAGS = {"--print", "-p", "--no-session", "--no-tools", "--no-builtin-tools", "--continue",
              "-c", "--resume", "-r", "--offline", "--no-extensions", "--no-skills", "--no-mcp",
              "--no-context-files", "-nc", "--approve", "--no-approve", "--verbose"}


def write_entry(path: Path, entry: dict) -> None:
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry, ensure_ascii=False) + "\n")


def main() -> int:
    argv = sys.argv[1:]
    rec = os.environ.get("MOCK_PI_RECORD")
    if rec:
        Path(rec).write_text(json.dumps(argv, ensure_ascii=False), encoding="utf-8")
    rec_dir = os.environ.get("MOCK_PI_RECORD_DIR")
    if rec_dir:
        Path(rec_dir).mkdir(parents=True, exist_ok=True)
        (Path(rec_dir) / f"{time.time_ns()}-{os.getpid()}.json").write_text(
            json.dumps(argv, ensure_ascii=False), encoding="utf-8")
    rec_cwd = os.environ.get("MOCK_PI_RECORD_CWD")
    if rec_cwd:
        Path(rec_cwd).write_text(os.getcwd(), encoding="utf-8")
    if "--help" in argv:
        print("mock_pi")
        return 0

    opts: dict = {}
    positionals: list = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            positionals += argv[i + 1:]
            break
        if a in VALUE_FLAGS:
            if i + 1 >= len(argv):
                print(f"Error: {a} requires a value", file=sys.stderr)
                return 1
            val = argv[i + 1]
            if a in MULTI_VALUE_FLAGS:
                # normalize -e into --extension
                key = "--extension" if a in ("-e", "--extension") else a
                opts.setdefault(key, []).append(val)
            else:
                opts[a] = val
            i += 2
            continue
        if a in BOOL_FLAGS:
            opts[a] = True
            i += 1
            continue
        if a.startswith("-"):
            print(f"Error: Unknown option: {a}", file=sys.stderr)
            return 1
        positionals.append(a)
        i += 1

    if "--provider" in opts and "--model" not in opts:
        print("Error: --provider requires --model", file=sys.stderr)
        return 1

    parts = []
    if not sys.stdin.isatty():
        piped = sys.stdin.read()
        if piped:
            parts.append(piped)
    for p in positionals:
        if p.startswith("@"):
            parts.append(Path(p[1:]).read_text(encoding="utf-8"))
        else:
            parts.append(p)
    prompt = "\n".join(parts)

    sdir = Path(opts.get("--session-dir") or (Path.cwd() / ".mock-sessions"))
    sid = None
    sfile = None
    if not opts.get("--no-session"):
        ref = opts.get("--session")
        if ref:
            cand = Path(ref)
            hits = [cand] if cand.is_file() else (list(sdir.rglob(f"*{ref}*.jsonl")) if sdir.is_dir() else [])
            if not hits:
                print(f"No session found matching '{ref}'", file=sys.stderr)
                return 1
            sfile = hits[0]
            sid = sfile.stem.split("_")[-1]
        else:
            sid = opts.get("--session-id") or str(uuid.uuid4())
            existing = list(sdir.rglob(f"*_{sid}.jsonl")) if sdir.is_dir() else []
            if existing:
                sfile = existing[0]
            else:
                sdir.mkdir(parents=True, exist_ok=True)
                sfile = sdir / f"{time.strftime('%Y-%m-%dT%H-%M-%S')}_{sid}.jsonl"
                write_entry(sfile, {"type": "session", "version": 3, "id": sid,
                                    "timestamp": "2026-01-01T00:00:00.000Z", "cwd": os.getcwd()})
        write_entry(sfile, {"type": "message", "message": {
            "role": "user", "content": [{"type": "text", "text": prompt}]}})

    sleep = float(os.environ.get("MOCK_PI_SLEEP") or 0)
    if os.environ.get("MOCK_PI_SLEEP_ON") and os.environ["MOCK_PI_SLEEP_ON"] in prompt:
        sleep = max(sleep, 30.0)
    if sleep:
        time.sleep(sleep)

    fail_on = os.environ.get("MOCK_PI_FAIL_ON")
    fail = os.environ.get("MOCK_PI_FAIL") == "1" or bool(fail_on and fail_on in prompt)

    reply = os.environ.get("MOCK_PI_REPLY") or f"mock-ok: {prompt[:300]}"
    if opts.get("--session"):
        reply += f" [resumed {sid}]"
    stop = os.environ.get("MOCK_PI_STOP") or "stop"
    usage_in, usage_out = 1234, 567
    if os.environ.get("MOCK_PI_USAGE"):
        usage_in, usage_out = (int(x) for x in os.environ["MOCK_PI_USAGE"].split(","))
    usage = {"input": usage_in, "output": usage_out, "cacheRead": 0, "cacheWrite": 0,
             "totalTokens": usage_in + usage_out,
             "cost": {"input": 0.003, "output": 0.008, "total": 0.011}}
    msg = {"role": "assistant", "content": [{"type": "text", "text": reply}], "stopReason": stop,
           "usage": usage}
    if stop in ("error", "aborted"):
        msg = {"role": "assistant", "content": [], "stopReason": stop,
               "errorMessage": f"mock {stop}: 529 overloaded", "usage": usage}
    if sfile and not fail:
        if stop in ("error", "aborted"):
            write_entry(sfile, {"type": "message", "message": {
                "role": "assistant", "stopReason": "toolUse",
                "content": [{"type": "text", "text": "let me look"}, {"type": "toolCall", "name": "ls"}]}})
            write_entry(sfile, {"type": "message", "message": {
                "role": "toolResult", "content": [{"type": "text", "text": "a.py"}]}})
        write_entry(sfile, {"type": "message", "message": msg})

    if opts.get("--mode") == "json":
        if sid:
            print(json.dumps({"type": "session", "version": 3, "id": sid,
                              "timestamp": "2026-01-01T00:00:00.000Z", "cwd": os.getcwd()}))
        print(json.dumps({"type": "agent_start"}))
        if not fail:
            print(json.dumps({"type": "message_end", "message": msg}, ensure_ascii=False))
            print(json.dumps({"type": "agent_end", "messages": [msg]}, ensure_ascii=False))
    elif not fail:
        print(reply)
        if stop != "stop":
            print(f"Error: {msg.get('errorMessage') or stop}", file=sys.stderr)
            return 1
    if fail:
        print("Error: mock provider failure (simulated)", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
